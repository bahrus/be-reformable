{
  "name": "be-reformable",
  "version": "0.0.77",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements",
    "decorator",
    "behavior",
    "directive"
  ],
  "description": "be-reformable is a web component that progressively enhances the built-in form element",
  "main": "be-reformable.js",
  "module": "be-reformable.js",
  "exports": {
    ".": "./be-reformable.js",
    "./be-reformable.js": "./be-reformable.js"
  },
  "files": [
    "*.*"
  ],
  "types": "types.d.ts",
  "dependencies": {
    "be-enhanced": "0.0.187",
    "be-hive": "0.0.265",
    "mount-observer": "0.0.102",
    "trans-render": "0.0.957"
  },
  "devDependencies": {
    "spa-ssi": "0.0.9",
    "@playwright/test": "1.55.0"
  },
  "scripts": {
    "test": "playwright test",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-reformable.git"
  },
  "author": "Bruce Anderson <anderson.bruce.b@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/be-reformable/issues"
  },
  "homepage": "https://github.com/bahrus/be-reformable#readme"
}
